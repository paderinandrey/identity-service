scalar Time

"""
Unified application user; referenced by GSH/DFM subgraphs by global id.
"""
type User @key(fields: "id") {
  id: ID!
  email: String!
  name: String!
  active: Boolean!
  lastSignInAt: Time
  roles: [RoleAssignment!]!
}

"""
Current viewer with effective permissions.
"""
type Me {
  user: User!
  permissions: [String!]!
}

type RoleAssignment {
  application: String!
  role: String!
  grantedBy: String!
  grantedAt: Time!
}

type Application {
  name: String!
  permissions: [String!]!
  roles: [Role!]!
}

type Role {
  application: String!
  name: String!
  permissions: [String!]!
}

"""
A page of users. Cursors are opaque; pass endCursor as `after` for the
next page.
"""
type UserConnection {
  nodes: [User!]!
  pageInfo: PageInfo!
}

type PageInfo {
  endCursor: String
  hasNextPage: Boolean!
}

type AuditEntry {
  id: ID!
  actor: String!
  action: String!
  targetUserId: ID
  "JSON-encoded action details"
  details: String!
  createdAt: Time!
}

type Query {
  me: Me!
  """
  Active users matching search, paged by keyset cursor; includeInactive
  adds deactivated ones. first is capped at 200.
  """
  users(search: String, includeInactive: Boolean! = false, first: Int! = 50, after: String): UserConnection!
  user(id: ID!): User
  applications: [Application!]!
  "Requires identity:access.manage."
  accessAuditLog(limit: Int! = 50): [AuditEntry!]!
}

type Mutation {
  "Requires identity:access.manage. Role format: app/role."
  grantRole(userId: ID!, role: String!): User!
  "Requires identity:access.manage. Role format: app/role."
  revokeRole(userId: ID!, role: String!): User!
}
