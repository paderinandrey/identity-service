{
  "name": "identity_development",
  "tables": [
    {
      "name": "public.access_audit_log",
      "type": "BASE TABLE",
      "comment": "Append-only journal of access changes, written in the same transaction as the change",
      "columns": [
        {
          "name": "action",
          "type": "text",
          "nullable": false,
          "comment": "Action name, e.g. role.grant, role.revoke, role.composition"
        },
        {
          "name": "actor",
          "type": "text",
          "nullable": false,
          "comment": "Who performed the change (cli or a user reference)"
        },
        {
          "name": "created_at",
          "type": "timestamp with time zone",
          "nullable": false,
          "default": "now()",
          "comment": "When the change happened"
        },
        {
          "name": "details",
          "type": "jsonb",
          "nullable": false,
          "default": "'{}'::jsonb",
          "comment": "Action details (application/role/permission names)"
        },
        {
          "name": "id",
          "type": "uuid",
          "nullable": false,
          "default": "gen_random_uuid()",
          "comment": "Journal entry UUID"
        },
        {
          "name": "role_id",
          "type": "uuid",
          "nullable": true,
          "comment": "Affected role; kept without FK so history survives role deletion"
        },
        {
          "name": "target_user_id",
          "type": "uuid",
          "nullable": true,
          "comment": "Affected user, when the action targets a user"
        }
      ],
      "indexes": [
        {
          "name": "access_audit_log_created_at_idx",
          "def": "CREATE INDEX access_audit_log_created_at_idx ON public.access_audit_log USING btree (created_at)",
          "table": "public.access_audit_log",
          "columns": [
            "created_at"
          ]
        },
        {
          "name": "access_audit_log_pkey",
          "def": "CREATE UNIQUE INDEX access_audit_log_pkey ON public.access_audit_log USING btree (id)",
          "table": "public.access_audit_log",
          "columns": [
            "id"
          ]
        },
        {
          "name": "access_audit_log_target_user_idx",
          "def": "CREATE INDEX access_audit_log_target_user_idx ON public.access_audit_log USING btree (target_user_id)",
          "table": "public.access_audit_log",
          "columns": [
            "target_user_id"
          ]
        }
      ],
      "constraints": [
        {
          "name": "access_audit_log_action_not_null",
